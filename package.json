{
	"name": "cinq",
	"version": "0.1.0",
	"description": "Two-way sync between Roblox Studio scripts and local files",
	"private": true,
	"license": "UNLICENSED",
	"engines": {
		"node": ">=20"
	},
	"scripts": {
		"start": "node server/cli.js run",
		"cinq": "node server/cli.js",
		"install-plugin": "node server/cli.js install-plugin",
		"test": "node --test \"server/test/*.test.js\""
	},
	"bin": {
		"cinq": "server/cli.js"
	}
}
